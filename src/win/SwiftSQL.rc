#pragma code_page(65001)

#include <windows.h>
#include "../core/Version.h"   // single source of truth for the version numbers

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "assets\\swiftsql.ico"

alipay_qr PNG "assets\\alipay_qr.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SWIFTSQL_VER_MAJOR,SWIFTSQL_VER_MINOR,SWIFTSQL_VER_PATCH,SWIFTSQL_VER_BUILD
 PRODUCTVERSION SWIFTSQL_VER_MAJOR,SWIFTSQL_VER_MINOR,SWIFTSQL_VER_PATCH,SWIFTSQL_VER_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "SwiftSQL Contributors\0"
            VALUE "FileDescription", "SwiftSQL\0"
            VALUE "FileVersion", SWIFTSQL_VER_STR "\0"
            VALUE "InternalName", "SwiftSQL\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 SwiftSQL Contributors\0"
            VALUE "OriginalFilename", "SwiftSQL.exe\0"
            VALUE "ProductName", "SwiftSQL\0"
            VALUE "ProductVersion", SWIFTSQL_VER_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
